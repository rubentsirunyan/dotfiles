[user]
  name = Ruben Tsirunyan
  # email is set in ~/.gitconfig.local
[core]
  fileMode = false
  editor = vim
  autocrlf = false
[pull]
  rebase = true
[push]
  default = current
[rebase]
  autoStash = true
[credential]
  helper = store
[diff]
  tool = vimdiff
[merge]
  tool = vimdiff
  ff = only

# Per-machine overrides — identity, includeIf blocks for projects, etc.
[include]
  path = ~/.gitconfig.local
